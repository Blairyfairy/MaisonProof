<?php $id = $block->getVerificationId(); ?>
<?php if ($id): ?>
<a hidden id="maisonproof-approval-badge" style="position:absolute;bottom:12px;right:12px;z-index:5;background:#152d4c;color:#fff;padding:7px 11px;border-radius:18px" href="https://maisonproof.org/verify/<?= $block->escapeUrl(rawurlencode($id)) ?>" target="_blank" rel="noopener noreferrer" title="View MaisonProof verification record"><img style="width:220px;max-width:100%;height:auto" src="<?= $block->escapeUrl($block->getViewFileUrl('MaisonProof_Verify::images/maisonproof-verified.png')) ?>" alt="Verified — View record"></a>
<script>
(function(){
 const id = <?= json_encode($id, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
 const el = document.getElementById('maisonproof-approval-badge');
 fetch('https://maisonproof.org/v1/records/' + encodeURIComponent(id), {credentials:'omit',cache:'no-store'})
  .then(r => {if(!r.ok) throw Error('unavailable');return r.json()})
  .then(d => {if(d.id === id && d.status === 'authenticated' && d.badge_active === true) el.hidden=false})
  .catch(()=>{});
})();
</script>
<?php endif; ?>
