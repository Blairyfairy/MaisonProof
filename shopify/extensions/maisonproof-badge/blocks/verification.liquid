{% liquid
  assign mp_status = product.metafields.maisonproof.status.value | default: 'not_verified'
  assign mp_record = product.metafields.maisonproof.record_id.value | default: ''
  if mp_record == blank
    assign mp_status = 'not_verified'
  endif
%}
{{ 'maisonproof-ui.css' | asset_url | stylesheet_tag }}
<div class="mp-ui mp-shopify" {{ block.shopify_attributes }}>
  <div class="mp-shell">
    <div class="mp-head">
      {% if block.settings.compact %}
        <img class="mp-mark" src="{{ 'maisonproof-mark.svg' | asset_url }}" width="40" height="40" alt="MaisonProof M">
      {% else %}
        <img class="mp-logo" src="{{ 'maisonproof-logo.svg' | asset_url }}" width="320" height="74" alt="MaisonProof Authentication Authority" loading="lazy">
      {% endif %}
      <span class="mp-badge" data-status="{{ mp_status | escape }}">
        {% case mp_status %}
          {% when 'verified' %}Verified
          {% when 'in_review' %}Under review
          {% when 'rejected' %}Not verified
          {% when 'revoked' %}Revoked
          {% when 'expired' %}Expired
          {% else %}Not verified
        {% endcase %}
      </span>
    </div>
    {% if mp_status == 'verified' %}
      {% assign mp_art = 'maisonproof-verified.png' %}
    {% else %}
      {% assign mp_art = 'maisonproof-not-verified.png' %}
    {% endif %}
    {% if mp_record != blank %}
      <a href="https://maisonproof.org/verify/{{ mp_record | url_encode }}" target="_blank" rel="noopener noreferrer"><img src="{{ mp_art | asset_url }}" width="320" style="max-width:100%;height:auto" alt="{{ mp_status | escape }} — View record"></a>
      <p class="mp-muted">MaisonProof record {{ mp_record | escape | truncate: 22 }}</p>
    {% else %}
      <img src="{{ mp_art | asset_url }}" width="320" style="max-width:100%;height:auto" alt="Not verified — no record">
      <p class="mp-muted">No independently verified MaisonProof record is associated with this product.</p>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "MaisonProof status",
  "target": "section",
  "settings": [
    {"type": "checkbox", "id": "compact", "label": "Use compact M monogram", "default": false}
  ]
}
{% endschema %}
