{% comment %} Render within the product image/media wrapper to position bottom-right. Set metafield maisonproof.record_id. Replace domain with your verified domain. {% endcomment %}
{% assign lp_id = product.metafields.maisonproof.record_id.value %}
{% if lp_id != blank %}
  <a hidden class="maisonproof-badge" href="https://maisonproof.org/verify/{{ lp_id | url_encode }}" target="_blank" rel="noopener noreferrer" title="View MaisonProof verification record" aria-label="View MaisonProof verification record"><img src="{{ 'maisonproof-verified.png' | asset_url }}" width="220" style="max-width:100%;height:auto" alt="Verified — View record"></a>
  <script>
  (function(){
    const id = {{ lp_id | json }};
    const el = document.currentScript.previousElementSibling;
    fetch('https://maisonproof.org/v1/records/' + encodeURIComponent(id), {credentials:'omit',cache:'no-store'})
      .then(r => {if(!r.ok) throw Error('unavailable'); return r.json()})
      .then(d => {if(d.id === id && d.status === 'authenticated' && d.badge_active === true) el.hidden = false})
      .catch(() => {});
  })();
  </script>
  <style>.maisonproof-badge{position:absolute;bottom:12px;right:12px;z-index:5;background:#152d4c;color:white;border:1px solid #d6ad66;border-radius:20px;padding:7px 11px;font:600 12px system-ui;text-decoration:none}</style>
{% endif %}
